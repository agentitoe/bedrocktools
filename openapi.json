        "description": "Cache preflight",
        "schema": {
          "type": "string",
          "example": "86400"
        }
      },
      "Vary": {
        "description": "Vary",
        "schema": {
          "type": "string",
          "example": "Origin"
        }
      },
      "Allow": {
        "description": "Allow",
        "schema": {
          "type": "string",
          "example": "GET, POST, OPTIONS"
        }
      },
      "ContentDisposition": {
        "description": "Attachment con nombre `_MODIFIED`",
        "schema": {
          "type": "string",
          "example": "attachment; filename=\"myPack_MODIFIED.mcaddon\""
        }
      },
      "ContentLength": {
        "schema": {
          "type": "integer",
          "example": 451
        }
      },
      "XAddonConverter": {
        "description": "Marca de conversión",
        "schema": {
          "type": "string",
          "example": "product_type=addon"
        }
      },
      "XAddonModified": {
        "description": "Si se encontró y modificó algún manifest behavior",
        "schema": {
          "type": "string",
          "enum": [
            "true",
            "false"
          ],
          "example": "true"
        }
      },
      "XAddonWarning": {
        "description": "Warning si no hubo behavior pack o extensión no estándar",
        "schema": {
          "type": "string",
          "example": "no behavior pack manifest found; file returned unchanged except re-zip"
        }
      },
      "CacheControl": {
        "schema": {
          "type": "string",
          "example": "no-store"
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string",
            "example": "Bad Request"
          },
          "message": {
            "type": "string",
            "example": "Campo 'file' requerido. Usa multipart/form-data con file=@tu.mcaddon"
          },
          "details": {
            "type": "string",
            "nullable": true,
            "example": "invalid zip data"
          },
          "hint": {
            "type": "string",
            "nullable": true,
            "example": "curl -F \"file=@addon.mcaddon\" /api/addon-converter"
          },
          "maxBytes": {
            "type": "integer",
            "nullable": true,
            "example": 31457280
          },
          "allowed": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true,
            "example": [
              "GET",
              "POST",
              "OPTIONS"
            ]
          }
        }
      },
      "JsonBase64Request": {
        "type": "object",
        "required": [
          "file"
        ],
        "description": "Alternativa JSON para entornos sin multipart (ej. server-to-server). `file` es base64 puro o data URI `data:application/zip;base64,...`.",
        "properties": {
          "file": {
            "type": "string",
            "format": "byte",
            "description": "Contenido del ZIP en base64",
            "example": "UEsDBBQACAgIA..."
          },
          "data": {
            "type": "string",
            "format": "byte",
            "description": "Alias de `file`"
          },
          "base64": {
            "type": "string",
            "format": "byte",
            "description": "Alias de `file`"
          },
          "filename": {
            "type": "string",
            "description": "Nombre original (para derivar `_MODIFIED`)",
            "example": "addon.mcaddon"
          },
          "name": {
            "type": "string",
            "description": "Alias de `filename`"
          },
          "fileName": {
            "type": "string",
            "description": "Alias de `filename`"
          }
        }
      },
      "GetDocsResponse": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Addon Converter API"
          },
          "description": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "example": "1.0.0"
          },
          "route": {
            "type": "string",
            "example": "/api/addon-converter"
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "GET",
              "POST",
              "OPTIONS"
            ]
          },
          "limits": {
            "type": "object",
            "properties": {
              "maxFileSize": {
                "type": "string",
                "example": "30 MB"
              },
              "allowedExtensions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "example": [
                  ".mcpack",
                  ".mcaddon",
                  ".zip"
                ]
              },
              "contentTypes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "get": {
            "type": "object"
          },
          "post": {
            "type": "object"
          }
        }
      }
    },
    "securitySchemes": {}
  }
}