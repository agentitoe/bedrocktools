{
  "openapi": "3.1.0",
  "info": {
    "title": "BedrockTools — Addon Converter",
    "version": "1.0.0",
    "summary": "Sube tu .mcaddon y juega con logros en Xbox / Upload your .mcaddon and play with achievements on Xbox",
    "description": "Sube tu .mcaddon y te lo devolvemos listo para usar con logros en Xbox.\nUpload your .mcaddon and get it back ready to use with achievements on Xbox.\n\nUsa POST con multipart (recomendado) o JSON con base64 (para bots).\nUse POST with multipart (recommended) or JSON with base64 (for bots).\n\nLímite: 30 MB. Docs: /api-docs/. CORS open.",
    "contact": {
      "name": "BedrockTools",
      "url": "https://github.com/agentitoe/bedrocktools"
    },
    "license": {
      "name": "GPL-3.0-only",
      "url": "https://github.com/agentitoe/bedrocktools/blob/main/LICENSE"
    }
  },
  "servers": [
    {
      "url": "https://bedrocktools.pages.dev",
      "description": "Production"
    },
    {
      "url": "http://localhost:8788",
      "description": "Local"
    }
  ],
  "tags": [
    {
      "name": "Addon Converter",
      "description": "Convierte addons para Bedrock / Convert addons for Bedrock"
    }
  ],
  "paths": {
    "/api/addon-converter": {
      "get": {
        "tags": [
          "Addon Converter"
        ],
        "summary": "Ayuda de la API (ES/EN según Accept-Language)",
        "description": "Devuelve una ayuda corta y humana. Idioma según `Accept-Language`: `es` → español, resto → inglés.\nReturns a short human-friendly help object. Language from `Accept-Language`: `es` → Spanish, everything else → English.",
        "operationId": "getAddonConverterDocs",
        "parameters": [
          {
            "name": "Accept-Language",
            "in": "header",
            "required": false,
            "description": "es → español, resto → inglés / es → Spanish, rest → English",
            "schema": {
              "type": "string",
              "example": "es"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ayuda bilingüe / Bilingual help",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDocsResponse"
                },
                "examples": {
                  "spanish": {
                    "summary": "Español (Accept-Language es)",
                    "value": {
                      "name": "Addon Converter",
                      "whatFor": "Sube tu .mcaddon y te lo devolvemos listo para usar con logros en Xbox.",
                      "usage": {
                        "multipart": "POST multipart/form-data con campo \"file\" (recomendado).",
                        "json": "POST application/json con {\"file\": \"<base64>\", \"filename\": \"addon.mcaddon\"} (para bots)."
                      },
                      "limits": {
                        "maxSize": "30 MB"
                      },
                      "exampleCurl": "curl -X POST https://bedrocktools.pages.dev/api/addon-converter -F \"file=@addon.mcaddon\" --output converted.mcaddon",
                      "docs": "/api-docs/"
                    }
                  },
                  "english": {
                    "summary": "English (default)",
                    "value": {
                      "name": "Addon Converter",
                      "whatFor": "Upload your .mcaddon and get it back ready to use with achievements on Xbox.",
                      "usage": {
                        "multipart": "POST multipart/form-data with field \"file\" (recommended).",
                        "json": "POST application/json with {\"file\": \"<base64>\", \"filename\": \"addon.mcaddon\"} (for bots)."
                      },
                      "limits": {
                        "maxSize": "30 MB"
                      },
                      "exampleCurl": "curl -X POST https://bedrocktools.pages.dev/api/addon-converter -F \"file=@addon.mcaddon\" --output converted.mcaddon",
                      "docs": "/api-docs/"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Addon Converter"
        ],
        "summary": "Convierte tu pack (.mcpack / .mcaddon / .zip)",
        "description": "Sube tu .mcaddon y te lo devolvemos listo para usar con logros en Xbox.\nUpload your .mcaddon and get it back ready to use with achievements on Xbox.\n\nDos formas:\n1. multipart con campo `file` (recomendado).\n2. JSON con `{\"file\": \"<base64>\", \"filename\": \"addon.mcaddon\"}` (para bots).\nPara cuerpo binario directo (raw) puedes pasar `?filename=pack.mcaddon`.",
        "operationId": "convertAddon",
        "parameters": [
          {
            "name": "filename",
            "in": "query",
            "required": false,
            "description": "Nombre para el archivo de salida cuando envías cuerpo binario directo / Output name when sending raw binary body",
            "schema": {
              "type": "string",
              "example": "addon.mcaddon"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Tu archivo .mcpack / .mcaddon / .zip",
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Tu archivo .mcaddon (campo \"file\")"
                  }
                }
              },
              "examples": {
                "curl": {
                  "summary": "Recomendado / Recommended",
                  "value": {
                    "file": "addon.mcaddon"
                  }
                }
              }
            },
            "application/zip": {
              "schema": {
                "type": "string",
                "format": "binary",
                "description": "Cuerpo binario directo. Usa ?filename= para el nombre / Raw binary body. Use ?filename= for the name"
              }
            },
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary",
                "description": "Cuerpo binario directo. Usa ?filename= para el nombre / Raw binary body. Use ?filename= for the name"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JsonBase64Request"
              },
              "examples": {
                "bot": {
                  "summary": "Para bots / For bots",
                  "value": {
                    "file": "UEsDBBQACAgIA...",
                    "filename": "addon.mcaddon"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tu archivo listo para usar / Your file ready to use",
            "headers": {
              "Content-Disposition": {
                "$ref": "#/components/headers/ContentDisposition"
              },
              "X-Addon-Modified": {
                "$ref": "#/components/headers/XAddonModified"
              },
              "X-Addon-Warning": {
                "$ref": "#/components/headers/XAddonWarning"
              }
            },
            "content": {
              "application/zip": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Falta archivo, archivo vacío, JSON/base64 no válido o archivo dañado / Missing/empty file, invalid JSON/base64 or damaged file",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "missingFile": {
                    "summary": "Falta archivo / Missing file",
                    "value": {
                      "error": "Missing file",
                      "code": "MISSING_FILE",
                      "message": "Upload a .mcpack/.mcaddon/.zip file",
                      "messageEs": "Sube un archivo .mcpack/.mcaddon/.zip"
                    }
                  },
                  "emptyFile": {
                    "summary": "Archivo vacío / Empty file",
                    "value": {
                      "error": "Empty file",
                      "code": "EMPTY_FILE",
                      "message": "The file is empty. Upload a valid .mcpack/.mcaddon/.zip file",
                      "messageEs": "El archivo está vacío. Sube un archivo .mcpack/.mcaddon/.zip válido"
                    }
                  },
                  "invalidJson": {
                    "summary": "JSON no válido / Invalid JSON",
                    "value": {
                      "error": "Invalid JSON",
                      "code": "INVALID_JSON",
                      "message": "Invalid JSON. Send {\"file\": \"<base64>\"}",
                      "messageEs": "JSON no válido. Envía {\"file\": \"<base64>\"}"
                    }
                  },
                  "invalidBase64": {
                    "summary": "Base64 no válido / Invalid base64",
                    "value": {
                      "error": "Invalid base64",
                      "code": "INVALID_BASE64",
                      "message": "Invalid base64 data",
                      "messageEs": "Datos base64 no válidos"
                    }
                  },
                  "invalidZip": {
                    "summary": "Archivo dañado / Damaged file",
                    "value": {
                      "error": "Invalid ZIP",
                      "code": "INVALID_ZIP",
                      "message": "Invalid or corrupted file. Upload a valid .mcpack/.mcaddon/.zip file",
                      "messageEs": "Archivo no válido o dañado. Sube un archivo .mcpack/.mcaddon/.zip válido"
                    }
                  }
                }
              }
            }
          },
          "405": {
            "description": "Método no permitido / Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Method not allowed",
                  "code": "METHOD_NOT_ALLOWED",
                  "message": "Method DELETE not allowed. Use GET or POST",
                  "messageEs": "Método DELETE no permitido. Usa GET o POST"
                }
              }
            }
          },
          "413": {
            "description": "Archivo muy grande (>30 MB) / File too large (>30 MB)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "File too large",
                  "code": "TOO_LARGE",
                  "message": "File is larger than 30 MB",
                  "messageEs": "El archivo supera los 30 MB"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "headers": {
      "ContentDisposition": {
        "description": "Descarga con nombre listo / Download with ready name",
        "schema": {
          "type": "string",
          "example": "attachment; filename=\"myPack_MODIFIED.mcaddon\""
        }
      },
      "XAddonModified": {
        "description": "true si tu pack quedó listo, false si venía sin cambios / true if your pack is ready, false if unchanged",
        "schema": {
          "type": "string",
          "enum": [
            "true",
            "false"
          ],
          "example": "true"
        }
      },
      "XAddonWarning": {
        "description": "Aviso humano solo si no había nada que convertir / Human notice only if there was nothing to convert",
        "schema": {
          "type": "string",
          "example": "No behavior pack found, file returned as-is"
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error",
          "code",
          "message",
          "messageEs"
        ],
        "properties": {
          "error": {
            "type": "string",
            "example": "Missing file"
          },
          "code": {
            "type": "string",
            "enum": [
              "MISSING_FILE",
              "EMPTY_FILE",
              "INVALID_JSON",
              "INVALID_BASE64",
              "INVALID_ZIP",
              "TOO_LARGE",
              "METHOD_NOT_ALLOWED"
            ],
            "example": "MISSING_FILE"
          },
          "message": {
            "type": "string",
            "example": "Upload a .mcpack/.mcaddon/.zip file"
          },
          "messageEs": {
            "type": "string",
            "example": "Sube un archivo .mcpack/.mcaddon/.zip"
          }
        }
      },
      "JsonBase64Request": {
        "type": "object",
        "required": [
          "file"
        ],
        "description": "Para bots sin multipart / For bots without multipart",
        "properties": {
          "file": {
            "type": "string",
            "format": "byte",
            "description": "Tu archivo en base64 / Your file in base64",
            "example": "UEsDBBQACAgIA..."
          },
          "filename": {
            "type": "string",
            "description": "Nombre original / Original name",
            "example": "addon.mcaddon"
          }
        }
      },
      "GetDocsResponse": {
        "type": "object",
        "required": [
          "name",
          "whatFor",
          "usage",
          "limits",
          "exampleCurl",
          "docs"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Addon Converter"
          },
          "whatFor": {
            "type": "string",
            "example": "Upload your .mcaddon and get it back ready to use with achievements on Xbox."
          },
          "usage": {
            "type": "object",
            "required": [
              "multipart",
              "json"
            ],
            "properties": {
              "multipart": {
                "type": "string",
                "example": "POST multipart/form-data with field \"file\" (recommended)."
              },
              "json": {
                "type": "string",
                "example": "POST application/json with {\"file\": \"<base64>\", \"filename\": \"addon.mcaddon\"} (for bots)."
              }
            }
          },
          "limits": {
            "type": "object",
            "required": [
              "maxSize"
            ],
            "properties": {
              "maxSize": {
                "type": "string",
                "example": "30 MB"
              }
            }
          },
          "exampleCurl": {
            "type": "string",
            "example": "curl -X POST https://bedrocktools.pages.dev/api/addon-converter -F \"file=@addon.mcaddon\" --output converted.mcaddon"
          },
          "docs": {
            "type": "string",
            "example": "/api-docs/"
          }
        }
      }
    },
    "securitySchemes": {}
  }
}
