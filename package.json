{
  "name": "bedrocktools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.mjs && bun scripts/fetch-fonts.mjs && bun scripts/extract-data.mjs && bun scripts/translate-items.mjs && bun scripts/fetch-geyser-mappings.mjs",
    "build:wasm": "bun scripts/build-wasm.mjs",
    "build:fonts": "bun scripts/fetch-fonts.mjs",
    "build:og": "bun scripts/build-og.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "dev": "bun run build && bun scripts/serve.mjs",
    "dev:functions": "wrangler pages dev public --port 8787",
    "deploy": "wrangler pages deploy public"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "elysia": "^1.4.30",
    "fflate": "^0.8.1",
    "minecraft-data": "^3.112.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@napi-rs/canvas": "^1.0.11",
    "typescript": "^7.0.2",
    "wrangler": "^4.149.0"
  }
}
